$ErrorActionPreference='Stop'
$currentRoot = 'C:\Users\natha\.openclaw'
$archiveRoot = 'D:\AegisForge\OpenClaw_Archive'
$workspace = 'C:\Users\natha\OneDrive\Desktop\Final_AegisForge_Fullstack'
$stamp = Get-Date -Format 'yyyyMMdd-HHmmss'

Write-Host '=== STEP 1: Locate current and archived .openclaw ==='
if (-not (Test-Path $currentRoot)) { throw "Current .openclaw not found at $currentRoot" }
$archCandidates = Get-ChildItem $archiveRoot -Directory -ErrorAction Stop | Sort-Object LastWriteTime
$old = $null
foreach ($d in $archCandidates) {
  $candidate = Join-Path $d.FullName '.openclaw'
  if (Test-Path $candidate) { $old = $candidate; break }
}
if (-not $old) { throw 'No archived .openclaw found under D:\AegisForge\OpenClaw_Archive' }
Write-Host "Current: $currentRoot"
Write-Host "Archived source: $old"

Write-Host '=== STEP 2: Backup current gateway config ==='
$backupDir = Join-Path $archiveRoot ("current-openclaw-backup-" + $stamp)
New-Item -ItemType Directory -Path $backupDir -Force | Out-Null
$filesToSync = @('openclaw.json','gateway.cmd','exec-approvals.json')
foreach ($f in $filesToSync) {
  $src = Join-Path $currentRoot $f
  if (Test-Path $src) { Copy-Item $src (Join-Path $backupDir $f) -Force }
}
Write-Host "Backup dir: $backupDir"
Get-ChildItem $backupDir -File | Select-Object Name,Length,LastWriteTime | Format-Table -AutoSize

Write-Host '=== STEP 3: Sync old gateway config files into current ==='
foreach ($f in $filesToSync) {
  $src = Join-Path $old $f
  $dst = Join-Path $currentRoot $f
  if (Test-Path $src) {
    Copy-Item $src $dst -Force
    Write-Host "Synced: $f"
  } else {
    Write-Host "Missing in archive (skipped): $f"
  }
}

Write-Host '=== STEP 4: Verify file hashes match archive ==='
foreach ($f in $filesToSync) {
  $src = Join-Path $old $f
  $dst = Join-Path $currentRoot $f
  if ((Test-Path $src) -and (Test-Path $dst)) {
    $h1 = (Get-FileHash $src -Algorithm SHA256).Hash
    $h2 = (Get-FileHash $dst -Algorithm SHA256).Hash
    Write-Host "$f hash match: $($h1 -eq $h2)"
  }
}

Write-Host '=== STEP 5: Save provided gateway log snapshot into workspace Cloud/OpenClaw ==='
$logDir = Join-Path $workspace 'Cloud\OpenClaw\gateway_logs'
New-Item -ItemType Directory -Path $logDir -Force | Out-Null
$logFile = Join-Path $logDir ("openclaw-gateway-session-" + (Get-Date -Format 'yyyyMMdd-HHmmss') + '.log')
@'

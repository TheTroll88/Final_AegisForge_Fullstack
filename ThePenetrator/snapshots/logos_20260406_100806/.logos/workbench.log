"""Agent loop — orchestrates LLM calls and tool execution."""

from logos.llm.client import LLMClient
from logos.tools.registry import ToolRegistry
from logos.core.session import Session
from logos.output.formatter import Formatter
from logos.output.workbench import Workbench


SYSTEM_TEMPLATE = """{identity}

{custom_rules}

TOOLS — use these by putting >> at the START of a new line:

>> READ path/to/file
>> WRITE path/to/file
```
file content here
```
>> EDIT path/to/file
FIND: exact text to find
REPLACE: replacement text
>> RUN command here
>> DELETE path/to/file
>> SEARCH regex pattern
>> LIST path/to/directory
>> GIT STATUS
>> GIT DIFF
>> GIT LOG
>> GIT COMMIT commit message here
>> IMAGE prompt [--model MODEL] [--output FILE]
>> TTS text to speak [--voice VOICE] [--output FILE]
>> TRANSCRIBE path/to/audio
>> EMBED text to embed
>> BALANCE
>> WEB_SEARCH query [--scrape]
>> CHAIN chain method [params...]
  Examples:
  >> CHAIN eth eth_getBalance 0x36A9D523d70AE8b47898bc9B148B929370C3693F latest
  >> CHAIN sol getBalance 4k24SEzbHyr49mBtYzu4e3K9EBtsuKTdkEN2mdmMkZow
  >> CHAIN base eth_blockNumber
  >> CHAIN eth alchemy_getAssetTransfers {{"fromBlock":"0x0","toBlock":"latest","toAddress":"0x...","category":["external"]}}
  Chains: eth, base, polygon, arb, opt, zora, sol (add _sepolia/_devnet for testnets)
>> PLUTUS start [--cores N]  Start Bitcoin key scanner in background
>> PLUTUS stop               Stop the scanner
>> PLUTUS status             Check if running + hit count
>> PLUTUS hits               Show any found wallets
>> TELEGRAM setup <api_id> <api_hash>   Configure Telegram API credentials
>> TELEGRAM login                       Show login instructions
>> TELEGRAM status                      Check connection status
>> TELEGRAM chats [--limit N]           List recent chats/channels/groups
>> TELEGRAM read <target> [--limit N]   Read messages from a channel/group/user
>> TELEGRAM search <query> [--in <target>] [--limit N]  Search messages
>> TELEGRAM send <target> <message>     Send a message
>> TELEGRAM info <target>               Get info about a user/channel/group
>> MEMORY remember <topic> <content>    Save a note to long-term memory
>> MEMORY recall <topic>                Read a memory topic
>> MEMORY search <query>                Search all memories
>> MEMORY list                          Show all memory topics
>> MEMORY forget <topic>                Delete a memory topic

IMPORTANT TOOL RULES:
- Only use >> commands when you NEED information or NEED to take action.
- After receiving tool results, RESPOND TO THE USER. Do not call more tools unless absolutely necessary.
- Do NOT read every file in the tree. Only read files relevant to the task.
- If you already have the information you need, just answer. No tools needed.
- Maximum 3 tool calls per response. Be surgical, not exhaustive.

== WORKSPACE: {workspace} ==
== FILE TREE ==
{tree}
"""


class AgentLoop:
    """Orchestrates the LLM + tool execution loop."""

    def __init__(self, client: LLMClient, registry: ToolRegistry,
                 session: Session, formatter: Formatter,
                 model: str, workspace: str, max_rounds: int = 3,
                 workbench: Workbench = None):
        self.client = client
        self.registry = registry
        self.session = session
        self.fmt = formatter
        self.model = model
        self.workspace = workspace
        self.max_rounds = max_rounds
        self.workbench = workbench or Workbench()

    def build_system_prompt(self, config: dict, tree: str, contents: str = "") -> str:
        """Build the full system prompt from config + workspace tree."""
        identity = config["agent"]["identity"]
        rules = "\n".join(f"- {r}" for r in config.get("custom_rules", []))
        return SYSTEM_TEMPLATE.format(
            identity=identity,
            custom_rules=rules,
            workspace=self.workspace,
            tree=tree,
        )

    def _detect_repetition(self, text: str, window: int = 40) -> bool:
        """Detect if the tail of a response is stuck in a repetition loop."""
        if len(text) < window * 3:
            return False
        tail = text[-window:]
        # Check if this exact window appears multiple times in the last 3x window
        region = text[-(window * 3):]
        return region.count(tail) >= 3

    def run_turn(self):
        """Run a single agent turn — may loop for tool calls."""
        for round_num in range(self.max_rounds):
            self.fmt.agent_prompt()

            # Stream the response with repetition cutoff
            full_response = ""
            was_truncated = False
            for token in self.client.chat_stream(
                self.session.get_messages(), self.model
            ):
                self.fmt.stream_token(token)
                full_response += token
                # Kill runaway repetition loops before they eat the context
                if len(full_response) > 2000 and self._detect_repetition(full_response):
                    self.fmt.stream_token("\n[Repetition detected — response truncated]")
                    was_truncated = True
                    break
            self.fmt.stream_end()

            if not full_response:
                break

            self.session.add("assistant", full_response)

            # Execute any >> commands
            results = self.registry.parse_freeform(full_response, self.workspace)

            if not results:
                break  # No tools called — agent is done

            # Show tool results and feed back
            result_text = ""
            for r in results:
                self.fmt.tool_exec(r.tool_name)
                self.fmt.tool_result(r.output)
                self.workbench.write(r.tool_name, r.output)
                result_text += f"[{r.tool_name}] {r.output}\n\n"

            # On last round, tell model to stop
            if round_num >= self.max_rounds - 1:
                self.session.add("user",
                    f"[TOOL RESULTS]\n{result_text}\n"
                    "You have reached the tool call limit. Respond to the user now with what you have. Do NOT call more tools.")
            else:
                self.session.add("user",
                    f"[TOOL RESULTS]\n{result_text}\n"
                    "Now respond to the user based on these results. Only use more tools if strictly necessary.")



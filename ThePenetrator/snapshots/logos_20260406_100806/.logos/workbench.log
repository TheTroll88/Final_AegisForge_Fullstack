"""Agent loop — orchestrates LLM calls and tool execution."""

from logos.llm.client import LLMClient
from logos.tools.registry import ToolRegistry
from logos.core.session import Session
from logos.output.formatter import Formatter
from logos.output.workbench import Workbench


SYSTEM_TEMPLATE = """{identity}

{custom_rules}

TOOLS — use these by putting >> at the START of a new line:

>> READ path/to/file
>> WRITE path/to/file
```
file content here
```

>> EDIT path/to/file
FIND: exact text to find
REPLACE: replacement text

>> DELETE path/to/file
>> RUN shell command
>> SEARCH pattern
>> LIST [path]
>> GIT STATUS | DIFF | LOG | COMMIT message
>> IMAGE prompt [--model MODEL] [--output FILE]
>> TTS text [--voice VOICE] [--output FILE]
>> TRANSCRIBE path/to/audio
>> EMBED text
>> BALANCE
>> CHAIN chain method [params]
>> WEB_SEARCH query [--scrape]
>> TELEGRAM setup|login|status|chats|read|search|send|info [args]
>> PLUTUS start|stop|status|hits [--cores N]
>> LAB claim|balance|status
>> MEMORY remember|recall|forget|list|search [topic] [content]

WORKSPACE CONTEXT:
{tree}

{file_contents}
"""


class AgentLoop:
    """Orchestrates LLM calls, tool parsing, and session management."""

    def __init__(self, client: LLMClient, registry: ToolRegistry, session: Session,
                 formatter: Formatter, model: str, workspace: str, workbench: Workbench = None):
        self.client = client
        self.registry = registry
        self.session = session
        self.fmt = formatter
        self._model = model
        self.workspace = workspace
        self.workbench = workbench

    @property
    def model(self) -> str:
        return self._model

    @model.setter
    def model(self, value: str):
        self._model = value

    def build_system_prompt(self, config: dict, tree: str, contents: str) -> str:
        """Build the full system prompt from config + workspace context."""
        identity = config.get("identity", "You are Logos, an AI agent.")
        rules = config.get("custom_rules", [])
        custom_rules = "\n".join(f"- {r}" for r in rules) if rules else ""

        return SYSTEM_TEMPLATE.format(
            identity=identity,
            custom_rules=custom_rules,
            tree=tree,
            file_contents=contents,
        )

    def run_turn(self):
        """Run one agent turn: LLM call → parse tools → execute → respond."""
        messages = self.session.get_messages()

        # Detect repetition loops
        if self._detect_repetition(messages):
            self.fmt.error("[Loop detected — breaking cycle]")
            return

        # Stream response from LLM
        self.fmt.agent_prompt()
        full_response = []
        try:
            for token in self.client.chat_stream(messages, self._model):
                self.fmt.stream_token(token)
                full_response.append(token)
        except Exception as e:
            self.fmt.stream_end()
            self.fmt.error(f"LLM call failed: {e}")
            return

        self.fmt.stream_end()
        response_text = "".join(full_response)

        if not response_text.strip():
            return

        # Add assistant response to session
        self.session.add("assistant", response_text)

        # Parse and execute any >> tool commands
        results = self.registry.parse_freeform(response_text, self.workspace)
        if results:
            feedback_parts = []
            for r in results:
                self.fmt.tool_exec(r.tool_name)
                if self.workbench:
                    self.workbench.write(r.tool_name, r.output)
                preview = r.output[:300] if r.output else "(no output)"
                self.fmt.tool_result(preview)
                status = "OK" if r.success else "FAILED"
                feedback_parts.append(f"[{r.tool_name}] {status}:\n{r.output}")

            # Feed tool results back for the next turn
            feedback = "\n\n".join(feedback_parts)
            self.session.add("user", f"[Tool results]\n{feedback}")
            # Recurse for the follow-up
            self.run_turn()

    def _detect_repetition(self, messages: list, window: int = 6) -> bool:
        """Check if the last few assistant messages are repeating."""
        assistant_msgs = [m["content"] for m in messages if m["role"] == "assistant"]
        if len(assistant_msgs) < window:
            return False
        recent = assistant_msgs[-window:]
        # If more than half are identical, it's a loop
        from collections import Counter
        counts = Counter(recent)
        most_common_count = counts.most_common(1)[0][1]
        return most_common_count >= (window // 2 + 1)


